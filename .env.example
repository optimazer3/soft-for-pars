# Скопируйте этот файл в .env и вставьте строку подключения к базе Supabase.
# Supabase → ваш проект → кнопка "Connect" → Connection string → "Session pooler" (URI).
# Замените [YOUR-PASSWORD] на пароль базы данных. Файл .env не попадает в git.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Для сервера (необязательно): ключи можно задать здесь вместо файлов в папке data/.
# SESSION_KEY=  любая длинная случайная строка — подписывает сессии входа
